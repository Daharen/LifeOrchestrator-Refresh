{
  "schema": "lifeorch.skill.manifest/0.1",
  "skill_id": "fixture.transcribe",
  "name": "Fixture Speech Transcriber",
  "version": "0.1.0",
  "contract_version": "0.2",
  "purpose": "Transcribe speech audio to text with word timestamps using a local whisper model.",
  "determinism": "mixed",
  "invocation": {
    "method": "pwsh-file",
    "entrypoint": "Invoke-FixtureTranscribe.ps1",
    "args_spec": "-Audio <path>"
  },
  "inputs": [
    {"name": "audio", "type": "string", "required": true, "description": "Path to a speech audio file."}
  ],
  "outputs": {"result_shape": "object", "description": "Transcript text + per-word timestamps."},
  "requirements": {
    "executables": ["pwsh>=7.4", "ffmpeg", "python>=3.8"], "models": ["whisper-small"], "libraries": [],
    "cpu": "any", "gpu": "none", "memory_mb": 1024,
    "network": false, "filesystem": "read", "audio": false, "screen": false, "camera": false
  },
  "artifacts": {"root": "runtime/artifacts/<invocation_id>/"},
  "timeout": {"default_seconds": 240, "on_timeout": "kill_tree_and_report"},
  "batch": false, "streaming": false, "parallel_safe": true,
  "example_invocation_file": "examples/example-invocation.md",
  "example_result_file": "examples/example-result.json"
}
