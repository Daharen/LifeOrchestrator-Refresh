{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lifeorch.project_map/0.1#relationships",
  "title": "project.map relationships file (documentation form)",
  "type": "object",
  "required": ["schema", "kind", "items"],
  "properties": {
    "schema": {"const": "lifeorch.project_map/0.1"},
    "kind": {"const": "relationships"},
    "items": {"type": "array", "items": {
      "type": "object",
      "required": ["from", "type", "to", "sources"],
      "properties": {
        "from": {"type": "string"}, "to": {"type": "string"},
        "type": {"enum": ["produces","consumes","invokes","routes-to","retrieves-from","compiles-for","verifies","authorizes","audits","persists","supersedes","depends-on","governs","realizes","documents"]},
        "sources": {"type": "array", "minItems": 1}
      },
      "description": "member-of is DERIVED and must NOT appear here. realizes: module:/widget:->arch:; persists/retrieves-from->store:; governs from contract:/doc:."
    }}
  }
}
